# Exact public URL, without a trailing slash (HTTPS in production).
APP_URL=https://eyesontheball.co.bw
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Enable for a remote MySQL provider that requires TLS.
DB_SSL=false
ADMIN_EMAIL=
# Generate locally with npm run admin:password; never use a plain password here.
ADMIN_PASSWORD_HASH=
# Optional additional administrators. Keep the primary credentials above unchanged.
# JSON array: [{"email":"admin@example.com","passwordHash":"scrypt:..."}]
ADMIN_ADDITIONAL_ACCOUNTS=[]

# Optional exact additional origins allowed to edit (comma-separated HTTPS URLs).
# Prefer signing in and editing on APP_URL consistently. Never use a wildcard.
ADMIN_ALLOWED_ORIGINS=
