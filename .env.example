# Exact public URL, without a trailing slash (HTTPS in production).
APP_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Enable for a remote MySQL provider that requires TLS.
DB_SSL=false
ADMIN_EMAIL=
# Generate locally with npm run admin:password; never use a plain password here.
ADMIN_PASSWORD_HASH=
